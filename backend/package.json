{
  "name": "ai-student-support-backend",
  "version": "1.0.0",
  "description": "AI-Powered Student Support System - AWS Lambda Backend",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && node esbuild.config.mjs",
    "package": "node scripts/package.mjs",
    "build:all": "npm run build && npm run package",
    "test:handler": "node scripts/test-handler.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.600.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.600.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1102.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.895.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.138",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
