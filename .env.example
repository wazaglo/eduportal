# =============================================================================
# AI-Powered Student Support System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for local development.
#   cp .env.example .env
# =============================================================================

# ─── AWS ─────────────────────────────────────────────────────────────────────
# AWS_REGION: region where the backend resources live.
# Default: eu-west-1
AWS_REGION=eu-west-1

# AWS_ENDPOINT: optional custom endpoint for DynamoDB (e.g. DynamoDB Local).
# Leave empty in production.
AWS_ENDPOINT=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── DynamoDB Table Names ────────────────────────────────────────────────────
TABLE_USERS=ai-student-users
TABLE_QUESTIONS=ai-student-questions
TABLE_CACHE=ai-student-cache
TABLE_ANALYTICS=ai-student-analytics
TABLE_FEEDBACK=ai-student-feedback
TABLE_KNOWLEDGE=ai-student-knowledge

# ─── S3 Knowledge Base ───────────────────────────────────────────────────────
KNOWLEDGE_BUCKET=eduportal-azubi-success-knowledge-base

# ─── Cognito (Authentication) ────────────────────────────────────────────────
COGNITO_USER_POOL_ID=eu-west-1_58jU3t3eE
COGNITO_CLIENT_ID=5u2cc85m997rvttujel00a0ngd

# ─── Bedrock AI ─────────────────────────────────────────────────────────────
# BEDROCK_MODEL_ID: primary model for answers.
# Default: eu.amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0

# BEDROCK_MODEL_ROUTINE: model for simple/quick questions.
# Default: eu.amazon.nova-lite-v1:0
BEDROCK_MODEL_ROUTINE=eu.amazon.nova-lite-v1:0

# BEDROCK_MODEL_COMPLEX: model for complex reasoning questions.
# Default: eu.amazon.nova-pro-v1:0
BEDROCK_MODEL_COMPLEX=eu.amazon.nova-pro-v1:0

# BEDROCK_KNOWLEDGE_BASE_ID: the Bedrock Knowledge Base ID for semantic search.
BEDROCK_KNOWLEDGE_BASE_ID=SSJQQYPJ4A

# BEDROCK_DATA_SOURCE_ID: the data source (eduportal-s3-knowledge) in the KB.
BEDROCK_DATA_SOURCE_ID=RQPXDTWNFN

# BEDROCK_GUARDRAIL_ID: the Bedrock Guardrail ID for content filtering.
BEDROCK_GUARDRAIL_ID=8tznv6byph2i

# BEDROCK_GUARDRAIL_VERSION: guardrail version (use DRAFT for testing).
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ─── CORS ────────────────────────────────────────────────────────────────────
# CORS_ORIGIN: allowed origin. In production, the Amplify app URL.
CORS_ORIGIN=*
